{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Portfolio frontend (React + TypeScript + Vite)",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{mts,js,json}\" \"seo/**/*.mts\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{mts,js,json}\" \"seo/**/*.mts\"",
        "check:preview-copy": "node scripts/check-preview-copy.mjs",
        "build": "npm run typecheck && vite build",
        "build:dev": "npm run typecheck && vite build --mode development",
        "build:prod": "npm run typecheck && vite build --mode production",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/assistant": "^5.3.0",
        "@fontsource/inter-tight": "^5.3.0",
        "@fontsource/karantina": "^5.3.0",
        "@fontsource/source-serif-4": "^5.3.1",
        "axios": "^1.18.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^17.7.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5"
    },
    "engines": {
        "node": ">=22.22.0",
        "npm": ">=10.8.2"
    }
}
